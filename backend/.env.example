# ── Application ─────────────────────────────────────────────
DEBUG=true

# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://docintel:docintel@localhost:5432/docintel

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM ───────────────────────────────────────────────────
# Supported providers: openai, gemini.
# Without a key for the selected provider, the system falls back to regex extraction.
LLM_PROVIDER=gemini
LLM_ENABLED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Confidence Thresholds ──────────────────────────────────
CONFIDENCE_AUTO_APPROVE=0.8
CONFIDENCE_REVIEW_THRESHOLD=0.5
